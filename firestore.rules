rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. 운영자 권한 목록 (Firebase Console -> Firestore 또는 Admin SDK에서만 등록)
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 2. 플레이어 클라우드 세이브 (본인 UID 또는 운영자만 읽기·쓰기 가능)
    match /saves/{uid} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // 3. 실시간 공지 · 이벤트 배율 (전체 읽기, 운영자만 쓰기)
    match /liveConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. 이벤트 쿠폰 (단건 조회만 허용해 코드 목록 유출 방지, 트랜잭션으로 1인 1회·선착순 제한 검증)
    match /coupons/{code} {
      allow get: if isSignedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.enabled == true
        && (resource.data.get('maxUses', 0) == 0 || resource.data.get('usedCount', 0) < resource.data.get('maxUses', 0))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
        && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
        && !exists(/databases/$(database)/documents/coupons/$(code)/claims/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/coupons/$(code)/claims/$(request.auth.uid))
      );

      // 쿠폰 1계정 1회 수령 기록
      match /claims/{uid} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/coupons/$(code)/claims/$(uid));
        allow update, delete: if isAdmin();
      }
    }
  }
}
